{
  "name": "relay-chat",
  "private": true,
  "workspaces": [
    "client"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server.js\" \"npm run dev -w client\"",
    "start": "node server.js",
    "build": "npm run build -w client",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.12.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "mongodb-memory-server": "^10.1.4"
  }
}
